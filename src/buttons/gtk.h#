;; ── MenuButton ──────────────────────────────────────────────────────────────

struct MenuButton is
    pub handle: int
end

pub fn new_menu_button(label: string) -> MenuButton is
    let h: int = gtk_ffi::gtk_menu_button_new()
    gtk_ffi::gtk_menu_button_set_label(h, label)
    return MenuButton { handle: h }
end

impl MenuButton is
    fn set_popover(self, popover: Popover) is
        gtk_ffi::gtk_menu_button_set_popover(self.handle, popover.handle)
    end

    fn set_label(self, label: string) is
        gtk_ffi::gtk_menu_button_set_label(self.handle, label)
    end

    fn set_icon_name(self, icon_name: string) is
        gtk_ffi::gtk_menu_button_set_icon_name(self.handle, icon_name)
    end
end

;; ── Popover ─────────────────────────────────────────────────────────────────

struct Popover is
    pub handle: int
end

pub fn new_popover() -> Popover is
    return Popover { handle: gtk_ffi::gtk_popover_new() }
end

impl Popover is
    fn set_child(self, child: int) is
        gtk_ffi::gtk_popover_set_child(self.handle, child)
    end

    fn popup(self) is gtk_ffi::gtk_popover_popup(self.handle) end
    fn popdown(self) is gtk_ffi::gtk_popover_popdown(self.handle) end

    ;; `false`: popover nie znika sam po kliknieciu poza nim.
    fn set_autohide(self, autohide: bool) is
        gtk_ffi::gtk_popover_set_autohide(self.handle, gtk::b2i(autohide))
    end

    fn set_has_arrow(self, has_arrow: bool) is
        gtk_ffi::gtk_popover_set_has_arrow(self.handle, gtk::b2i(has_arrow))
    end
end
