struct Box is
    pub handle: int
end

pub fn new_box(orientation: int, spacing: int) -> Box is
    return Box { handle: gtk_ffi::gtk_box_new(orientation, spacing) }
end

;; Skroty: pionowy / poziomy kontener liniowy.
pub fn vbox(spacing: int) -> Box is
    return Box { handle: gtk_ffi::gtk_box_new(1, spacing) }
end

pub fn hbox(spacing: int) -> Box is
    return Box { handle: gtk_ffi::gtk_box_new(0, spacing) }
end

impl Box is
    fn append(self, child: int) is
        gtk_ffi::gtk_box_append(self.handle, child)
    end

    ;; To samo co `append`. Osobna nazwa, bo kompilator H# uznaje kazde `x.append(..)` w domknieciu za mutacje
    ;; zmiennej `x` (heurystyka dla tablic) i przechwytuje ja przez referencje — dla uchwytow GTK konczylo
    ;; sie to wiszaca referencja po powrocie z funkcji. `add_child` takiej heurystyki nie wyzwala.
    fn add_child(self, child: int) is
        gtk_ffi::gtk_box_append(self.handle, child)
    end

    fn prepend(self, child: int) is
        gtk_ffi::gtk_box_prepend(self.handle, child)
    end

    fn remove(self, child: int) is
        gtk_ffi::gtk_box_remove(self.handle, child)
    end

    ;; Przesuwa `child` tuz za `sibling` (sibling = 0: na sam poczatek).
    fn reorder_after(self, child: int, sibling: int) is
        gtk_ffi::gtk_box_reorder_child_after(self.handle, child, sibling)
    end

    ;; Usuwa wszystkie dzieci (np. przed przebudowaniem listy).
    fn clear(self) is
        let mut child: int = gtk_ffi::gtk_widget_get_first_child(self.handle)
        while child != 0 is
            let next: int = gtk_ffi::gtk_widget_get_next_sibling(child)
            gtk_ffi::gtk_box_remove(self.handle, child)
            child = next
        end
    end

    fn set_spacing(self, spacing: int) is
        gtk_ffi::gtk_box_set_spacing(self.handle, spacing)
    end

    fn set_homogeneous(self, homogeneous: bool) is
        gtk_ffi::gtk_box_set_homogeneous(self.handle, gtk::b2i(homogeneous))
    end
end

