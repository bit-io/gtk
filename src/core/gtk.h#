;; Zapis tekstu do schowka systemowego. Odczyt w GTK4 jest asynchroniczny
;; (`GAsyncReadyCallback` = C-owy wskaznik funkcji), wiec poza zakresem 100% H#.
pub fn clipboard_set_text(text: string) is
    let display: int = gtk_ffi::gdk_display_get_default()
    let clipboard: int = gtk_ffi::gdk_display_get_clipboard(display)
    gtk_ffi::gdk_clipboard_set_text(clipboard, text)
end

pub fn style_priority_application() -> int is return 600 end
pub fn style_priority_user()        -> int is return 800 end

;; Wczytuje arkusz CSS z tekstu i podpina go pod domyslny display —
;; obejmie od razu wszystkie okna aplikacji.
pub fn load_css(css: string) is
    let provider: int = gtk_ffi::gtk_css_provider_new()
    gtk_ffi::gtk_css_provider_load_from_string(provider, css)
    let display: int = gtk_ffi::gdk_display_get_default()
    gtk_ffi::gtk_style_context_add_provider_for_display(display, provider, style_priority_application())
end

;; Jak `load_css`, ale wczytuje arkusz z pliku `.css` na dysku.
pub fn load_css_file(path: string) is
    let provider: int = gtk_ffi::gtk_css_provider_new()
    gtk_ffi::gtk_css_provider_load_from_path(provider, path)
    let display: int = gtk_ffi::gdk_display_get_default()
    gtk_ffi::gtk_style_context_add_provider_for_display(display, provider, style_priority_application())
end

;; (0.3) Otwiera adres (http/https/file/mailto...) w domyslnej aplikacji systemu
;; przez `g_app_info_launch_default_for_uri` (synchronicznie, bez callbacku).
;; Zwraca `true`, gdy system przyjal zadanie.
pub fn open_uri(uri: string) -> bool is
    return gtk_ffi::g_app_info_launch_default_for_uri(uri, 0, 0) != 0
end

;; (0.3) Ciemny motyw GTK bez libadwaita: ustawia GTK_THEME, jesli uzytkownik
;; nie wybral wlasnego. Wolac PRZED `gtk::init_gtk()`.
pub fn prefer_dark() is
    if env::get("GTK_THEME") == "" is
        env::set("GTK_THEME", "Adwaita:dark")
    end
end

;; (0.3) Dodatkowa referencja na widget (g_object_ref) — widget zostaje poprawna pamiecia
;; nawet po usunieciu z drzewa. Uzyj, gdy zalozony timer moze dotknac widgetu, ktory
;; uzytkownik w miedzyczasie zniszczyl; po zakonczeniu zadania wywolaj `release`.
pub fn keep(handle: int) is
    gtk_ffi::g_object_ref(handle)
end

pub fn release(handle: int) is
    gtk_ffi::g_object_unref(handle)
end

;; (0.3) Nawigacja po drzewie widgetow (0 = brak).
pub fn first_child(handle: int) -> int is
    return gtk_ffi::gtk_widget_get_first_child(handle)
end

pub fn next_sibling(handle: int) -> int is
    return gtk_ffi::gtk_widget_get_next_sibling(handle)
end

;; (0.3) Widget -> okno-korzen (handle `GtkRoot`), 0 gdy widget nie jest jeszcze w oknie.
pub fn widget_root(handle: int) -> int is
    return gtk_ffi::gtk_widget_get_root(handle)
end
