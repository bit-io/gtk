struct Label is
    pub handle: int
end

pub fn new_label(text: string) -> Label is
    return Label { handle: gtk_ffi::gtk_label_new(text) }
end

;; Etykieta z Pango markup, np. "<b>pogrubione</b> i <i>kursywa</i>".
pub fn new_markup_label(markup: string) -> Label is
    let h: int = gtk_ffi::gtk_label_new("")
    gtk_ffi::gtk_label_set_markup(h, markup)
    return Label { handle: h }
end

impl Label is
    ;; (0.3) Minimalna szerokosc w znakach (np. kolumna kluczy w tabeli).
    fn set_width_chars(self, n_chars: int) is
        gtk_ffi::gtk_label_set_width_chars(self.handle, n_chars)
    end

    fn set_text(self, text: string) is
        gtk_ffi::gtk_label_set_text(self.handle, text)
    end

    fn text(self) -> string is
        return gtk_ffi::gtk_label_get_text(self.handle)
    end

    fn set_markup(self, markup: string) is
        gtk_ffi::gtk_label_set_markup(self.handle, markup)
    end

    fn set_wrap(self, wrap: bool) is
        gtk_ffi::gtk_label_set_wrap(self.handle, gtk::b2i(wrap))
    end

    fn set_xalign(self, xalign: f64) is
        gtk_ffi::gtk_label_set_xalign(self.handle, xalign)
    end

    ;; Pozwala zaznaczac i kopiowac tekst etykiety myszka.
    fn set_selectable(self, selectable: bool) is
        gtk_ffi::gtk_label_set_selectable(self.handle, gtk::b2i(selectable))
    end

    ;; Patrz `gtk::ellipsize_*()`.
    fn set_ellipsize(self, mode: int) is
        gtk_ffi::gtk_label_set_ellipsize(self.handle, mode)
    end

    fn set_max_width_chars(self, n_chars: int) is
        gtk_ffi::gtk_label_set_max_width_chars(self.handle, n_chars)
    end

    ;; Patrz `gtk::justify_*()`.
    fn set_justify(self, justification: int) is
        gtk_ffi::gtk_label_set_justify(self.handle, justification)
    end

    fn set_lines(self, lines: int) is
        gtk_ffi::gtk_label_set_lines(self.handle, lines)
    end
end

;; ── Entry ───────────────────────────────────────────────────────────────────

struct Entry is
    pub handle: int
end

pub fn new_entry(placeholder: string) -> Entry is
    let h: int = gtk_ffi::gtk_entry_new()
    gtk_ffi::gtk_entry_set_placeholder_text(h, placeholder)
    return Entry { handle: h }
end

impl Entry is
    fn text(self) -> string is
        return gtk_ffi::gtk_editable_get_text(self.handle)
    end

    fn set_text(self, text: string) is
        gtk_ffi::gtk_editable_set_text(self.handle, text)
    end

    fn placeholder(self) -> string is
        return gtk_ffi::gtk_entry_get_placeholder_text(self.handle)
    end

    fn set_placeholder(self, text: string) is
        gtk_ffi::gtk_entry_set_placeholder_text(self.handle, text)
    end

    ;; `false` = zamiast znakow kropki (jak pole hasla).
    fn set_visibility(self, visible: bool) is
        gtk_ffi::gtk_entry_set_visibility(self.handle, gtk::b2i(visible))
    end

    fn set_max_length(self, max_length: int) is
        gtk_ffi::gtk_entry_set_max_length(self.handle, max_length)
    end

    fn set_editable(self, editable: bool) is
        gtk_ffi::gtk_editable_set_editable(self.handle, gtk::b2i(editable))
    end

    fn is_editable(self) -> bool is
        return gtk_ffi::gtk_editable_get_editable(self.handle) != 0
    end

    fn set_width_chars(self, n_chars: int) is
        gtk_ffi::gtk_editable_set_width_chars(self.handle, n_chars)
    end

    fn select_all(self) is
        gtk_ffi::gtk_editable_select_region(self.handle, 0, -1)
    end

    fn select_region(self, start_pos: int, end_pos: int) is
        gtk_ffi::gtk_editable_select_region(self.handle, start_pos, end_pos)
    end

    fn set_position(self, position: int) is
        gtk_ffi::gtk_editable_set_position(self.handle, position)
    end

    fn position(self) -> int is
        return gtk::c_int(gtk_ffi::gtk_editable_get_position(self.handle))
    end
end

