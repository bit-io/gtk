impl gtk_App is
    ;; (0.3) `unwatch` dla `handle` i WSZYSTKICH jego potomkow. Wolaj przed
    ;; `Box::clear` / usunieciem calego poddrzewa, w ktorym rejestrowano zdarzenia.
    fn unwatch_tree(self, handle: int) is
        self.unwatch(handle)
        let mut c: int = gtk_ffi::gtk_widget_get_first_child(handle)
        while c != 0 is
            self.unwatch_tree(c)
            c = gtk_ffi::gtk_widget_get_next_sibling(c)
        end
    end

