;; ── DropDown / ListBox ──────────────────────────────────────────────────────────────
impl gtk_DropDown is
    ;; Usuwa wszystkie opcje.
    fn clear(self) is
        let n: int = self.count()
        if n > 0 is gtk_ffi::gtk_string_list_splice(self.model, 0, n, 0) end
    end

    ;; Podmienia cala liste opcji.
    fn set_items(self, items: [string]) is
        self.clear()
        let mut i: int = 0
        while i < items.len() is
            self.append(items[i])
            i += 1
        end
    end
end

impl gtk_ListBox is
    fn set_show_separators(self, show: bool) is
        gtk_ffi::gtk_list_box_set_show_separators(self.handle, gtk::b2i(show))
    end

    ;; Widget wiersza o danym indeksie albo 0, gdy nie istnieje.
    fn row_at(self, index: int) -> int is
        return gtk_ffi::gtk_list_box_get_row_at_index(self.handle, index)
    end

    ;; Dziala tylko przy `selection_mode_multiple()`.
    fn select_all(self) is
        gtk_ffi::gtk_list_box_select_all(self.handle)
    end
end
