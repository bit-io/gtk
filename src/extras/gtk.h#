;; ── ScrolledWindow: przewijanie programowe ───────────────────────────────────────
;; Uwaga: rozmiar zawartosci zmienia sie dopiero po przeliczeniu ukladu (nastepna klatka).
;; Po `append` do listy/logu wywolaj `scroll_to_bottom` z timera: `app.after(50, fn() ...)`.
impl gtk_ScrolledWindow is
    fn scroll_to_top(self) is
        let adj: int = gtk_ffi::gtk_scrolled_window_get_vadjustment(self.handle)
        gtk_ffi::gtk_adjustment_set_value(adj, gtk_ffi::gtk_adjustment_get_lower(adj))
    end

    fn scroll_to_bottom(self) is
        let adj: int = gtk_ffi::gtk_scrolled_window_get_vadjustment(self.handle)
        let target: f64 = gtk_ffi::gtk_adjustment_get_upper(adj) - gtk_ffi::gtk_adjustment_get_page_size(adj)
        gtk_ffi::gtk_adjustment_set_value(adj, target)
    end

    ;; Pozycja pionowego przewiniecia w pikselach.
    fn scroll_value(self) -> f64 is
        return gtk_ffi::gtk_adjustment_get_value(gtk_ffi::gtk_scrolled_window_get_vadjustment(self.handle))
    end

    fn set_scroll_value(self, value: f64) is
        gtk_ffi::gtk_adjustment_set_value(gtk_ffi::gtk_scrolled_window_get_vadjustment(self.handle), value)
    end
end

