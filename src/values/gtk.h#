struct Scale is
    pub handle: int
end

;; Suwak (poziomy lub pionowy) z zakresem [min, max] i krokiem `step`.
pub fn new_scale(orientation: int, min: f64, max: f64, step: f64) -> Scale is
    return Scale { handle: gtk_ffi::gtk_scale_new_with_range(orientation, min, max, step) }
end

impl Scale is
    fn value(self) -> f64 is
        return gtk_ffi::gtk_range_get_value(self.handle)
    end

    fn set_value(self, value: f64) is
        gtk_ffi::gtk_range_set_value(self.handle, value)
    end

    fn set_range(self, min: f64, max: f64) is
        gtk_ffi::gtk_range_set_range(self.handle, min, max)
    end

    fn set_increments(self, step: f64, page: f64) is
        gtk_ffi::gtk_range_set_increments(self.handle, step, page)
    end

    ;; Czy nad suwakiem ma byc wyswietlana jego liczbowa wartosc.
    fn set_draw_value(self, draw: bool) is
        gtk_ffi::gtk_scale_set_draw_value(self.handle, gtk::b2i(draw))
    end

    fn set_digits(self, digits: int) is
        gtk_ffi::gtk_scale_set_digits(self.handle, digits)
    end

    ;; Patrz `gtk::position_*()`.
    fn set_value_pos(self, pos: int) is
        gtk_ffi::gtk_scale_set_value_pos(self.handle, pos)
    end

    ;; Znacznik na osi (markup moze byc pusty: "").
    fn add_mark(self, value: f64, pos: int, markup: string) is
        gtk_ffi::gtk_scale_add_mark(self.handle, value, pos, markup)
    end

    fn clear_marks(self) is
        gtk_ffi::gtk_scale_clear_marks(self.handle)
    end
end

