;; Callbacki C (0.4) — zwykle funkcje, ich nazwa uzyta jako wartosc to wskaznik C.
;; Wolane przez GLib w glownym watku. Tylko zapisuja zdarzenie w kolejce; zwracaja 0
;; (gboolean FALSE — dla `close-request` oznacza „nie blokuj domyslnej obslugi”).
fn cb_clicked(widget: int, q: int) -> int is
    gtk_ffi::g_queue_push_tail(q, 1)
    gtk_ffi::g_queue_push_tail(q, widget)
    return 0
end

fn cb_activate(widget: int, q: int) -> int is
    gtk_ffi::g_queue_push_tail(q, 2)
    gtk_ffi::g_queue_push_tail(q, widget)
    return 0
end

;; GAsyncReadyCallback(source_object, GAsyncResult*, user_data) — result trzymamy (ref)
;; do czasu wywolania `*_finish` w `App::poll`.
fn cb_file_done(source: int, result: int, q: int) -> int is
    gtk_ffi::g_object_ref(result)
    gtk_ffi::g_queue_push_tail(q, source)
    gtk_ffi::g_queue_push_tail(q, result)
    return 0
end

