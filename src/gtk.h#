        self.cal_cb.push(cb)
    end

    ;; Wola `cb` co `interval_ms` milisekund (pierwszy raz po jednym okresie).
    ;; Zwraca identyfikator timera dla `cancel`. Rozdzielczosc ~4 ms (petla
    ;; `run()` przechodzi w tryb nieblokujacy, gdy istnieje jakikolwiek timer).
    fn every(self, interval_ms: int, cb: fn() -> void) -> int is
        let now: int = gtk_ffi::g_get_monotonic_time() / 1000
        self.tmr_interval.push(interval_ms)
        self.tmr_next.push(now + interval_ms)
        self.tmr_repeat.push(1)
        self.tmr_active.push(1)
        self.tmr_cb.push(cb)
        return self.tmr_cb.len() - 1
    end

    ;; Wola `cb` dokladnie raz, po `delay_ms` milisekundach. Zwraca id dla `cancel`.
    fn after(self, delay_ms: int, cb: fn() -> void) -> int is
        let now: int = gtk_ffi::g_get_monotonic_time() / 1000
        self.tmr_interval.push(delay_ms)
        self.tmr_next.push(now + delay_ms)
        self.tmr_repeat.push(0)
        self.tmr_active.push(1)
        self.tmr_cb.push(cb)
        return self.tmr_cb.len() - 1
    end

    ;; Zatrzymuje timer o danym id (z `every` / `after`). Nieznane id jest ignorowane.
    fn cancel(self, id: int) is
        if id >= 0 && id < self.tmr_cb.len() is
            self.tmr_active[id] = 0
        end
    end

    ;; Ile timerow jeszcze dziala.
    fn active_timers(self) -> int is
        let mut n: int = 0
        let mut i: int = 0
        while i < self.tmr_active.len() is
            if self.tmr_active[i] == 1 is n += 1 end
            i += 1
        end
        return n
    end

    ;; Przestaje obserwowac widget `handle` we WSZYSTKICH rodzajach zdarzen.
