    ;; Rejestruje domkniecie wolane przy zmianie aktywnej zakladki `Notebook`;
    ;; dostaje jej indeks (0-based). W 100% wiarygodne.
    fn on_page_change(self, notebook: Notebook, cb: fn(int) -> void) is
        self.nb_widget.push(notebook.handle)
        self.nb_prev.push(notebook.current())
        self.nb_cb.push(cb)
    end

    ;; Najlepsze mozliwe (bez C) przyblizenie sygnalu `close-request`:
    ;; trzyma dodatkowa referencje (`g_object_ref`) na oknie, zeby bylo
    ;; bezpiecznie odpytywac jego stan `mapped` nawet po tym, jak domyslny
    ;; handler GTK zniszczy widget po kliknieciu w „X”. Gdy `mapped`
    ;; spadnie z 1 na 0, wolane jest `cb`. Jesli chcesz zeby to jednoczesnie
    ;; konczylo `run()`, wywolaj w `cb` po prostu `app.quit()`.
    ;; `unwatch(window.handle)` zwalnia te dodatkowa referencje.
    fn on_window_close(self, window: Window, cb: fn() -> void) is
        gtk_ffi::g_object_ref(window.handle)
        self.win_widget.push(window.handle)
        self.win_prev.push(1)
        self.win_cb.push(cb)
    end

