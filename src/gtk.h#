        return c_int(gtk_ffi::gtk_text_buffer_get_line_count(buf))
    end

    fn set_editable(self, editable: bool) is
        gtk_ffi::gtk_text_view_set_editable(self.handle, b2i(editable))
    end

    ;; Patrz `gtk::wrap_*()`.
    fn set_wrap(self, wrap_mode: int) is
        gtk_ffi::gtk_text_view_set_wrap_mode(self.handle, wrap_mode)
    end

    fn set_monospace(self, monospace: bool) is
