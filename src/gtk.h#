pub fn new_window(title: string, width: int, height: int) -> Window is
    let h: int = gtk_ffi::gtk_window_new()
    gtk_ffi::gtk_window_set_title(h, title)
    gtk_ffi::gtk_window_set_default_size(h, width, height)
    return Window { handle: h }
end

pub fn new_box(orientation: int, spacing: int) -> Box is
    return Box { handle: gtk_ffi::gtk_box_new(orientation, spacing) }
end

