;; ── Calendar ──────────────────────────────────────────────────────────────────
;; Zaznaczona data jest pakowana w jedna liczbe `rok*10000 + miesiac*100 + dzien`
;; (GDateTime zwalniany zawsze od razu).

fn calendar_packed(handle: int) -> int is
    let dt: int = gtk_ffi::gtk_calendar_get_date(handle)
    let y: int = c_int(gtk_ffi::g_date_time_get_year(dt))
    let m: int = c_int(gtk_ffi::g_date_time_get_month(dt))
    let d: int = c_int(gtk_ffi::g_date_time_get_day_of_month(dt))
    gtk_ffi::g_date_time_unref(dt)
    return y * 10000 + m * 100 + d
end

impl Calendar is
    fn year(self) -> int is
        return calendar_packed(self.handle) / 10000
    end

    ;; 1..12
    fn month(self) -> int is
        return (calendar_packed(self.handle) / 100) % 100
    end

    ;; 1..31
    fn day(self) -> int is
        return calendar_packed(self.handle) % 100
    end

    ;; Zaznaczona data jako tekst `RRRR-MM-DD`.
    fn date_string(self) -> string is
        let p: int = calendar_packed(self.handle)
        let m: int = (p / 100) % 100
        let d: int = p % 100
        let ms: string = if m < 10 then "0" + to_string(m) else to_string(m)
        let ds: string = if d < 10 then "0" + to_string(d) else to_string(d)
        return to_string(p / 10000) + "-" + ms + "-" + ds
    end

    ;; Pogrubia dzien miesiaca (1..31) w widoku kalendarza.
    fn mark_day(self, day: int) is
        gtk_ffi::gtk_calendar_mark_day(self.handle, day)
    end

    fn clear_marks(self) is
        gtk_ffi::gtk_calendar_clear_marks(self.handle)
    end
end

