    end

    ;; Indeks zaznaczonego wiersza (0-based), albo `-1` jesli nic nie wybrano.
    fn selected_index(self) -> int is
        let row: int = gtk_ffi::gtk_list_box_get_selected_row(self.handle)
        if row == 0 is return -1 end
        return c_int(gtk_ffi::gtk_list_box_row_get_index(row))
    end

    ;; Zaznacza wiersz o danym indeksie (nic nie robi, gdy go nie ma).
