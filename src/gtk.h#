;; Mala pomocnicza funkcja wykrywania zbocza wciśnięcie→puszczenie (uzywana
;; zarowno dla klikniec przyciskow jak i dla "submit" po utracie fokusu),
;; zeby petle w `poll()` nie powielaly tej samej logiki porownania w kolko.
fn edge_high_to_low(prev: int, cur: int) -> bool is
    return prev == 1 && cur == 0
end

impl App is
    ;; Rejestruje domkniecie wolane przy wykryciu klikniecia przycisku
    ;; (zbocze wcisniecie→puszczenie na fladze stanu GTK_STATE_FLAG_ACTIVE).
    fn on_click(self, button: Button, cb: fn() -> void) is
        self.btn_widget.push(button.handle)
        self.btn_prev.push(0)
        self.btn_cb.push(cb)
    end

    ;; Jak `on_click`, ale wolane w chwili WCISNIECIA (zbocze puszczenie→wcisniecie),
    ;; a nie puszczenia przycisku. Przydatne np. do „przytrzymaj, zeby ...”.
    fn on_press(self, button: Button, cb: fn() -> void) is
        self.press_widget.push(button.handle)
        self.press_prev.push(0)
        self.press_cb.push(cb)
    end

    ;; Rejestruje domkniecie wolane przy kazdej zmianie stanu checkboksa;
    ;; dostaje nowy stan (`true`/`false`) jako argument.
    fn on_toggle(self, check: CheckButton, cb: fn(bool) -> void) is
        self.chk_widget.push(check.handle)
        self.chk_prev.push(gtk_ffi::gtk_check_button_get_active(check.handle))
        self.chk_cb.push(cb)
    end

    ;; Jak `on_toggle`, ale dla `ToggleButton` (takze przyciskow w grupie „radio”).
    fn on_toggle_button(self, toggle: ToggleButton, cb: fn(bool) -> void) is
        self.tgl_widget.push(toggle.handle)
        self.tgl_prev.push(gtk_ffi::gtk_toggle_button_get_active(toggle.handle))
        self.tgl_cb.push(cb)
    end

    ;; Rejestruje domkniecie wolane przy przelaczeniu `Switch`; dostaje nowy stan.
    fn on_switch(self, sw: Switch, cb: fn(bool) -> void) is
        self.swt_widget.push(sw.handle)
        self.swt_prev.push(gtk_ffi::gtk_switch_get_active(sw.handle))
