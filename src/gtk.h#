;; ── Window ────────────────────────────────────────────────────────────────────

impl Window is
    fn set_child(self, child: int) is
        gtk_ffi::gtk_window_set_child(self.handle, child)
    end

    fn present(self) is
        gtk_ffi::gtk_window_present(self.handle)
    end

    fn show(self) is
        gtk_ffi::gtk_widget_show(self.handle)
    end

    fn set_title(self, title: string) is
        gtk_ffi::gtk_window_set_title(self.handle, title)
    end

    fn title(self) -> string is
        return gtk_ffi::gtk_window_get_title(self.handle)
    end

    fn set_resizable(self, resizable: bool) is
        gtk_ffi::gtk_window_set_resizable(self.handle, b2i(resizable))
    end

    fn set_modal(self, modal: bool) is
        gtk_ffi::gtk_window_set_modal(self.handle, b2i(modal))
    end

    fn set_decorated(self, decorated: bool) is
        gtk_ffi::gtk_window_set_decorated(self.handle, b2i(decorated))
    end

    ;; Wlasny pasek tytulu (np. `HeaderBar`) zamiast systemowego.
    fn set_titlebar(self, titlebar: int) is
        gtk_ffi::gtk_window_set_titlebar(self.handle, titlebar)
    end

    fn set_icon_name(self, icon_name: string) is
        gtk_ffi::gtk_window_set_icon_name(self.handle, icon_name)
    end

    ;; Okno-dziecko zawsze nad `parent` (typowe dla dialogow).
    fn set_transient_for(self, parent: Window) is
        gtk_ffi::gtk_window_set_transient_for(self.handle, parent.handle)
    end

    ;; `true`: klik w „X” tylko ukrywa okno (nie niszczy go).
    fn set_hide_on_close(self, hide_on_close: bool) is
        gtk_ffi::gtk_window_set_hide_on_close(self.handle, b2i(hide_on_close))
    end

    ;; Widget aktywowany klawiszem Enter w oknie (np. przycisk „OK”).
    fn set_default_widget(self, widget: int) is
        gtk_ffi::gtk_window_set_default_widget(self.handle, widget)
    end

    fn is_active(self) -> bool is
        return gtk_ffi::gtk_window_is_active(self.handle) != 0
    end

    fn is_maximized(self) -> bool is
        return gtk_ffi::gtk_window_is_maximized(self.handle) != 0
    end

    fn is_fullscreen(self) -> bool is
        return gtk_ffi::gtk_window_is_fullscreen(self.handle) != 0
    end

    fn maximize(self) is gtk_ffi::gtk_window_maximize(self.handle) end
    fn unmaximize(self) is gtk_ffi::gtk_window_unmaximize(self.handle) end
    fn minimize(self) is gtk_ffi::gtk_window_minimize(self.handle) end
    fn fullscreen(self) is gtk_ffi::gtk_window_fullscreen(self.handle) end
    fn unfullscreen(self) is gtk_ffi::gtk_window_unfullscreen(self.handle) end

    ;; Zamyka okno tak jak klik w „X” (respektuje `set_hide_on_close`).
    fn close(self) is
        gtk_ffi::gtk_window_close(self.handle)
    end

    ;; Niszczy okno natychmiast (np. po `app.quit()`, jesli chcesz tez
    ;; posprzatac widget zamiast tylko zatrzymac petle).
    fn destroy(self) is
        gtk_ffi::gtk_window_destroy(self.handle)
    end
end

;; ── Box ───────────────────────────────────────────────────────────────────────

impl Box is
    fn append(self, child: int) is
        gtk_ffi::gtk_box_append(self.handle, child)
    end

    fn prepend(self, child: int) is
        gtk_ffi::gtk_box_prepend(self.handle, child)
    end

    fn remove(self, child: int) is
        gtk_ffi::gtk_box_remove(self.handle, child)
    end

    ;; Przesuwa `child` tuz za `sibling` (sibling = 0: na sam poczatek).
    fn reorder_after(self, child: int, sibling: int) is
        gtk_ffi::gtk_box_reorder_child_after(self.handle, child, sibling)
    end

    ;; Usuwa wszystkie dzieci (np. przed przebudowaniem listy).
    fn clear(self) is
        let mut child: int = gtk_ffi::gtk_widget_get_first_child(self.handle)
        while child != 0 is
            let next: int = gtk_ffi::gtk_widget_get_next_sibling(child)
            gtk_ffi::gtk_box_remove(self.handle, child)
            child = next
        end
    end

    fn set_spacing(self, spacing: int) is
        gtk_ffi::gtk_box_set_spacing(self.handle, spacing)
    end

    fn set_homogeneous(self, homogeneous: bool) is
        gtk_ffi::gtk_box_set_homogeneous(self.handle, b2i(homogeneous))
    end
end

;; ── Button / ToggleButton / LinkButton ────────────────────────────────────────

impl Button is
    fn set_label(self, label: string) is
        gtk_ffi::gtk_button_set_label(self.handle, label)
    end

    fn label(self) -> string is
        return gtk_ffi::gtk_button_get_label(self.handle)
    end

    fn set_icon_name(self, icon_name: string) is
        gtk_ffi::gtk_button_set_icon_name(self.handle, icon_name)
    end

    ;; `false` = przycisk bez ramki (plaski), jak w paskach narzedzi.
    fn set_has_frame(self, has_frame: bool) is
        gtk_ffi::gtk_button_set_has_frame(self.handle, b2i(has_frame))
    end

    ;; Biezacy (natychmiastowy) stan "wcisniety" — czysty odczyt stanu GTK,
    ;; w 100% wiarygodny. Przydatne np. do animacji "press and hold".
    fn is_pressed(self) -> bool is
        let flags: int = gtk_ffi::gtk_widget_get_state_flags(self.handle)
        return (flags & 1) != 0   ;; GTK_STATE_FLAG_ACTIVE
    end
end

impl ToggleButton is
    fn is_active(self) -> bool is
        return gtk_ffi::gtk_toggle_button_get_active(self.handle) != 0
    end

    fn set_active(self, active: bool) is
        gtk_ffi::gtk_toggle_button_set_active(self.handle, b2i(active))
    end

    fn set_label(self, label: string) is
        gtk_ffi::gtk_button_set_label(self.handle, label)
    end

    ;; Laczy przyciski w grupe „radio” — w grupie aktywny jest tylko jeden.
    ;; Wywolaj na kazdym przycisku poza pierwszym, podajac pierwszy jako lidera.
    fn set_group(self, leader: ToggleButton) is
        gtk_ffi::gtk_toggle_button_set_group(self.handle, leader.handle)
    end

    ;; Ten sam widget jako `Button` (np. do `app.on_click`).
    fn as_button(self) -> Button is
        return Button { handle: self.handle }
    end
end

impl LinkButton is
    fn uri(self) -> string is
        return gtk_ffi::gtk_link_button_get_uri(self.handle)
