    end

    ;; Usuwa wszystkie wiersze.
    fn clear(self) is
        let mut row: int = gtk_ffi::gtk_widget_get_first_child(self.handle)
        while row != 0 is
            let next: int = gtk_ffi::gtk_widget_get_next_sibling(row)
            gtk_ffi::gtk_list_box_remove(self.handle, row)
            row = next
        end
    end

