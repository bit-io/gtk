;; ── TextView ──────────────────────────────────────────────────────────────────
;; Tekst siedzi w `GtkTextBuffer`; do jego odczytu GTK wymaga dwoch
;; `GtkTextIter` (struktury C po 80 B) — alokujemy je na chwile przez `g_malloc0`.

;; Cala zawartosc bufora widgetu `handle`.
;; Uwaga: `gtk_text_buffer_get_text` zwraca swiezo zaalokowany `char*`, ktorego
;; nie da sie zwolnic bez surowego wskaznika — kazdy odczyt przecieka kopie
;; tekstu (patrz README, „Znane ograniczenia”).
fn text_view_text(handle: int) -> string is
    let buf: int = gtk_ffi::gtk_text_view_get_buffer(handle)
    let iters: int = gtk_ffi::g_malloc0(160)
    gtk_ffi::gtk_text_buffer_get_start_iter(buf, iters)
    gtk_ffi::gtk_text_buffer_get_end_iter(buf, iters + 80)
    let t: string = gtk_ffi::gtk_text_buffer_get_text(buf, iters, iters + 80, 1)
    gtk_ffi::g_free(iters)
    return t
end

impl TextView is
    fn text(self) -> string is
        return text_view_text(self.handle)
    end

    fn set_text(self, text: string) is
        let buf: int = gtk_ffi::gtk_text_view_get_buffer(self.handle)
        gtk_ffi::gtk_text_buffer_set_text(buf, text, -1)
    end

    ;; Dopisuje tekst w miejscu kursora (domyslnie: na koncu pustego bufora).
    fn append(self, text: string) is
        let buf: int = gtk_ffi::gtk_text_view_get_buffer(self.handle)
        gtk_ffi::gtk_text_buffer_insert_at_cursor(buf, text, -1)
    end

    fn char_count(self) -> int is
        let buf: int = gtk_ffi::gtk_text_view_get_buffer(self.handle)
        return c_int(gtk_ffi::gtk_text_buffer_get_char_count(buf))
    end

    fn line_count(self) -> int is
