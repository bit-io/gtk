;; ── AlertDialog (GTK >= 4.10) — prosty komunikat, bez odczytu wyboru ────────
;; Zwraca sie od razu (fire-and-forget). Jesli potrzebujesz przyciskow z
;; odczytem wyboru uzytkownika, to (tak jak `close-request`) wymaga
;; asynchronicznego C-owego callbacku i jest poza zakresem biblioteki w
;; 100% H# — patrz README.md, sekcja "Znane ograniczenia".
pub fn show_alert(parent: Window, message: string, detail: string) is
    let safe_message: string = strings::replace_all(message, "%", "%%")
    let dialog: int = gtk_ffi::gtk_alert_dialog_new(safe_message)
    gtk_ffi::gtk_alert_dialog_set_modal(dialog, 1)
    if detail.len() > 0 is
        gtk_ffi::gtk_alert_dialog_set_detail(dialog, detail)
    end
    gtk_ffi::gtk_alert_dialog_show(dialog, parent.handle)
end

