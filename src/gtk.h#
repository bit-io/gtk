;; ── Drobne pomocnicze (prywatne) ──────────────────────────────────────────────

;; bool -> gboolean
fn b2i(b: bool) -> int is
    let r: int = if b then 1 else 0
    return r
end

;; FFI zwraca `gint` jako 64-bitowe `int` bez rozszerzenia znaku: `-1` wraca jako
;; 4294967295. Ta funkcja przywraca znak (dotyczy wynikow typu `gint`, np. numer
;; strony / pozycja / szerokosc; `guint` zostaje bez zmian).
fn c_int(v: int) -> int is
    if v >= 2147483648 is return v - 4294967296 end
    return v
end

