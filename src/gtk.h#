    ;; Rejestruje domkniecie wolane przy kazdej zmianie tekstu w polu
    ;; (dostaje nowa tresc jako argument). Dla `PasswordEntry`/`SearchEntry` uzyj `.as_entry()`.
    fn on_change(self, entry: Entry, cb: fn(string) -> void) is
        self.entry_widget.push(entry.handle)
        self.entry_prev.push(gtk_ffi::gtk_editable_get_text(entry.handle))
