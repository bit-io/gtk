    ;; Rejestruje domkniecie wolane przy kazdej zmianie stanu "najechania
    ;; myszka" (flaga GTK_STATE_FLAG_PRELIGHT) na dowolnym widgecie —
    ;; dostaje nowy stan (`true` = kursor nad widgetem) jako argument.
    ;; W 100% wiarygodne (zwykly odczyt stanu, tak jak `on_toggle`).
    fn on_hover(self, handle: int, cb: fn(bool) -> void) is
        self.hover_widget.push(handle)
        self.hover_prev.push(0)
        self.hover_cb.push(cb)
    end

